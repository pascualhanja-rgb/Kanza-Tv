# Copie este ficheiro para .env e preencha os valores reais.
DATABASE_URL='postgresql://user:password@host/db?sslmode=require'
JWT_SECRET=change-me-min-64-random-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:*
PORT=3000
NODE_ENV=development

TMDB_API_KEY=
TMDB_AUTH_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=pt-BR
TMDB_CACHE_TTL=300

JIKAN_BASE_URL=https://api.jikan.moe/v4

IPTV_M3U_URL=https://iptv-org.github.io/iptv/index.m3u
IPTV_ALLOWED_COUNTRIES=
IPTV_SYNC_BATCH_LIMIT=0

ADMIN_SYNC_KEY=change-me
